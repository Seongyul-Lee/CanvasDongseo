{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CanvasDongseo",
  "identifier": "io.github.seongyul-lee.canvasdongseo",
  "build": {
    "frontendDist": "../../../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../../../ui" },
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../../../ui" }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CanvasDongseo",
        "width": 1024,
        "height": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
